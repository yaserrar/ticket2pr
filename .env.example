# Ticket2PR configuration. `npm run setup` copies this file to .env.
# Trello credentials and the optional GitHub token are entered in the app (stored in data/app.db), not here.

# SQLite file, relative to the project root.
DATABASE_URL="file:./data/app.db"

# Optional. Port for `npm run dev` / `npm start` (the app always listens on 127.0.0.1 only).
# PORT=3000

# Optional. "claude" (default) runs Claude Code with your Claude subscription login
# (run `claude`, then /login, once). "fake" simulates runs without using your plan.
# RUNNER="claude"

# Optional. A `claude` binary to use instead of the one bundled with the Agent SDK.
# CLAUDE_CODE_PATH="/opt/homebrew/bin/claude"

# Optional. Where card worktrees and downloaded Trello attachments go (default ~/.ticket2pr/worktrees).
# WORKTREES_DIR="/Users/me/.ticket2pr/worktrees"

# Optional. debug | info | warn | error
# LOG_LEVEL="info"

# Optional, for tests and local mocks: point the Trello and GitHub clients somewhere else.
# TRELLO_API_BASE="https://api.trello.com/1"
# GITHUB_API_BASE="https://api.github.com"
